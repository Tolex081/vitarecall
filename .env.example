# Server only. Copy to .env and fill locally; never commit private values.
# Do not use VITE_ prefixes for any secrets.
PORT=3001
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
DATA_DIR=./data

# Optional locally; REQUIRED on Vercel. PostgreSQL replaces local SQLite when set.
# Supabase project > Connect > Transaction pooler. Copy its exact host/username.
# Insert your database password privately, percent-encoding reserved characters.
# Never use a VITE_ prefix or paste the connection string into chat/GitHub.
DATABASE_URL=
# Optional PEM root certificate from Supabase Database settings > SSL.
# The app verifies TLS certificates; use this if the issuer is not trusted by Node.
# Quoted literal \n sequences are converted to newlines. Never disable TLS checks.
DATABASE_CA_CERT=

# Optional: long private invite for legacy email/password clinician registration.
# The default X-handle demo profile flow does not need an invite.
CLINICIAN_INVITE_CODE=

# Your own mainnet MemWal account and Ed25519 delegate private key.
# Create at https://memory.walrus.xyz. Never reuse public example credentials.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_URL=https://relayer.memory.walrus.xyz

# Actual server-side Gemini API key from https://aistudio.google.com/api-keys
# This is NOT the Walrus account ID, delegate key, or a Google project ID.
# Save .env and restart the API server after changing it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Vercel: exact public HTTPS APP_ORIGIN, COOKIE_SECURE=true, DATABASE_URL required.
# Add server secrets privately in Vercel settings, then redeploy. No VITA_API_ORIGIN.
# Run npm run db:migrate explicitly before sending traffic to PostgreSQL.
# Persistent-server SQLite alternative: leave DATABASE_URL empty, mount DATA_DIR,
# run one Node instance, and back up the volume. Never put SQLite in Vercel /tmp.
